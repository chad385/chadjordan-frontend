      },
      "h3": {
        "family": "heading",
        "weight": 400,
        "size": "fluid.h3"
      },
      "body": {
        "family": "body",
        "weight": 300,
        "size": "15px"
      },
      "label": {
        "family": "mono",
        "weight": 400,
        "size": "10px",
        "letterSpacing": "0.2em",
        "transform": "uppercase"
      }
    }
