      "bounce": "cubic-bezier(0.68, -0.55, 0.265, 1.55)"
    }
  },
  "signatures": {
    "accentEmphasis": "the pivot word in a headline is set in gold + italic (em -> font-style:italic; color:accent)",
    "rules": "0.5px hairline in gold at 0.18 alpha, as dividers and edges",
    "labels": "DM Mono, uppercase, letter-spacing 0.18-0.22em, small (9-13px) — eyebrows, meta, tags",
    "textOnDark": "warm bone #ede8dc, never pure white",
    "corners": "sharp, radius 0",
    "depth": "flat — no shadows"
  },
  "fontsToLoad": [
    "Bricolage Grotesque (weights 400)",
    "DM Sans (weights 300, 400)",
    "DM Mono (weights 300, 400, 500)"
  ],
