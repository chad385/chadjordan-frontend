{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chadjordan-frontend",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  // Keep the workers.dev URL alive (the backend references it, and it's a
  // fallback) alongside the production custom domain.
  "workers_dev": true,
  "routes": [
    { "pattern": "chadjordan.studio", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // Runtime duplicates of NEXT_PUBLIC_ vars — Workers can't read NEXT_PUBLIC_ at runtime
  // Replace these with your own Supabase credentials
  "vars": {
    "SUPABASE_URL": "https://unlmfpqxjuxdqqifxvxm.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_28zqFB6-_3UnbwwRUJwCEQ_pBmzYDhw",
    // Backend admin OS URL — the footer "Admin" link target. Update to a
    // custom domain (e.g. https://admin.chadjordan.studio) at go-live.
    "NEXT_PUBLIC_ADMIN_URL": "https://chadjordan-backend.chad-1a0.workers.dev"
  }
}
